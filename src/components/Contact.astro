---
// src/components/Contact.astro
---

<section id="contacto" class="scroll-mt-[76px] w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-[#cbd5e1] border-t border-zinc-300 flex flex-col justify-center items-center">
  
  <!-- Contenedor Estilo Terminal / Console Box -->
  <div class="max-w-xl mx-auto bg-white border border-zinc-300/90 rounded-2xl shadow-xl shadow-zinc-400/20 overflow-hidden w-full my-auto">
    
    <!-- Barrita Superior de Consola -->
    <div class="bg-slate-800 px-4 py-2.5 flex items-center justify-between border-b border-slate-700">
      <div class="flex items-center space-x-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
      </div>
      <span class="text-[10px] font-mono text-cyan-300 tracking-wider uppercase">
        Veyxara // Connect & Networking
      </span>
    </div>

    <div class="p-6 sm:p-8 space-y-6">
      
      <!-- Encabezado -->
      <div class="text-center space-y-2">
        <span class="text-xs font-mono font-extrabold text-amber-700 uppercase tracking-widest block">
          COLABORACIÓN & CANALES TÉCNICOS
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 uppercase tracking-tight">
          Contacto y Redes
        </h2>
        <p class="text-zinc-700 text-xs sm:text-sm max-w-md mx-auto font-medium">
          Conectemos para debatir sobre infraestructura, automatización en PowerShell o revisar proyectos de ingeniería.
        </p>
      </div>

      <!-- Botones Principales de Canales Técnicos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        
        <!-- LinkedIn -->
        <a 
          href="https://www.linkedin.com/in/alfredoarevalo-infrati" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 bg-zinc-900 hover:bg-zinc-800 text-white font-bold py-3 px-4 rounded-xl transition-all text-xs sm:text-sm shadow-sm group"
        >
          <svg class="w-4 h-4 fill-cyan-400 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span>LinkedIn Profile</span>
        </a>

        <!-- GitHub direct to recursos-publicos -->
        <a 
          href="https://github.com/alfredoarevalo69/recursos-publicos" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2.5 bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-900 font-bold py-3 px-4 rounded-xl transition-all text-xs sm:text-sm shadow-xs group"
        >
          <svg class="w-4 h-4 fill-slate-800 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>Recursos Públicos</span>
        </a>

      </div>

      <!-- Nota de Privacidad / Alcance Abierto -->
      <div class="bg-amber-50/80 border border-amber-200/80 rounded-xl p-3.5 text-center">
        <p class="text-[11px] sm:text-xs text-amber-900 font-semibold font-mono">
          📌 Espacio dedicado exclusivamente al intercambio técnico, la investigación y la documentación abierta.
        </p>
      </div>

      <!-- Correo de Contacto Actualizado -->
      <div class="pt-4 border-t border-zinc-200 text-center space-y-2">
        <span class="text-xs font-mono font-bold text-slate-500 uppercase tracking-wider block">
          Contacto Profesional Directo
        </span>
        
        <div class="inline-flex items-center justify-center">
          <a 
            href="mailto:contacto@veyxara.com?subject=Consulta%20T%C3%A9cnica%20-%20Veyxara%20Lab" 
            class="text-zinc-900 hover:text-amber-700 transition-colors font-mono font-bold text-xs sm:text-sm flex items-center gap-2 bg-slate-100 hover:bg-slate-200 px-4 py-2 rounded-lg border border-zinc-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2.22 2.22 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>contacto@veyxara.com</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>