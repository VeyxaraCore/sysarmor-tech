---
// src/components/DesafiosCriticos.astro

const desafios = [
  { 
    code: "01",
    category: "EVOLUCIÓN & ESTABILIDAD",
    title: "Sistemas Legados & EOL", 
    desc: "Análisis de riesgos y metodologías de modernización para plataformas fuera de soporte (EOL), enfocadas en la transición segura hacia Windows Server 2025 y la continuidad operativa." 
  },
  { 
    code: "02",
    category: "HARDENING & AMENAZAS",
    title: "Análisis de Brechas & Seguridad", 
    desc: "Investigación de vectores de exposición, evaluación de políticas de endurecimiento (ASR / Defender) y utilitarios para el análisis de identidades, correo y cabeceras." 
  },
  { 
    code: "03",
    category: "AUTOMATIZACIÓN & POWERSHELL",
    title: "Optimización & Scripting", 
    desc: "Estrategias para la reducción de tareas manuales repetitivas mediante scripting avanzado en PowerShell, administración eficiente en Entra ID y resolución de fallas de Nivel 3." 
  },
  { 
    code: "04",
    category: "MARCOS DE SEGURIDAD",
    title: "Alineación & Compliance", 
    desc: "Guías sobre la implementación práctica de marcos de seguridad, políticas de grupo (GPO) y buenas prácticas de configuración para el endurecimiento de infraestructura híbrida." 
  }
];
---

<section id="desafios" class="w-full min-h-[calc(100vh-76px)] py-12 px-4 sm:px-6 bg-[#cbd5e1] border-y border-zinc-300 flex flex-col justify-center items-center scroll-mt-[76px]">
  <div class="max-w-6xl mx-auto w-full my-auto space-y-8">
    
    <!-- Encabezado claro -->
    <div class="text-center space-y-2">
      <h2 class="text-xl md:text-2xl font-bold text-neutral-900 tracking-wide uppercase">
        Escenarios Técnicos & Desafíos de Ingeniería
      </h2>
      <p class="text-zinc-700 font-medium text-xs md:text-sm font-sans max-w-2xl mx-auto">
        Casos reales y temas clave de infraestructura, seguridad y automatización documentados en este sitio.
      </p>
    </div>
    
    <!-- Grid de Desafíos con Estilo Moderno / Técnico -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {desafios.map(item => (
        <div class="bg-slate-50/90 hover:bg-white p-6 rounded-xl border-l-4 border-l-amber-600 border-y border-r border-slate-300/80 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
          
          <div class="space-y-3">
            <!-- Fila Superior: Badge + Código de Índice -->
            <div class="flex items-center justify-between">
              <span class="inline-block px-2.5 py-0.5 rounded-md bg-amber-100 text-amber-900 border border-amber-300/60 text-[10px] font-mono font-bold tracking-wider uppercase">
                {item.category}
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 group-hover:text-amber-700 transition-colors">
                //{item.code}
              </span>
            </div>

            <!-- Título -->
            <h3 class="text-base font-display font-bold text-slate-900 leading-snug pt-1">
              {item.title}
            </h3>

            <!-- Separador sutil -->
            <div class="w-8 h-0.5 bg-amber-500/40 group-hover:w-16 transition-all duration-300"></div>

            <!-- Descripción -->
            <p class="text-xs text-slate-600 leading-relaxed font-sans pt-1">
              {item.desc}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>