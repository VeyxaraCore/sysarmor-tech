---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBgImg from '../assets/images/hero-datacenter.webp';
---

<section class="hero-container">
  <!-- Imagen de fondo base -->
  <div class="hero-bg-wrapper">
    <Image 
      src={heroBgImg} 
      alt="Fondo Infraestructura Crítica y Ecosistema Microsoft" 
      width={1920}
      height={1080}
      format="webp"
      quality={85}
      loading="eager" 
      fetchpriority="high"
      decoding="sync"
      class="hero-bg"
    />

    <!-- LIENZO PROPORCIONAL 16:9 PARA ANCLAJE PERFECTO -->
    <div class="hero-canvas-art">
      <div class="cpu-anchor">
        <div class="cpu-core-glow"></div>
        <div class="light-beam"></div>
      </div>
    </div>
  </div>

  <div class="hero-inner">
    <div class="hero-content">
      
      <!-- Isotipo con animación de pulso sutil (EXCLUSIVO PARA MÓVIL) -->
      <div class="mobile-badge-container md:hidden">
        <div class="mobile-badge">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
      </div>

      <!-- TÍTULO -->
      <h1 class="hero-title">
        Arquitectura y modernización de <br />
        <span class="highlight">infraestructura crítica en entornos híbridos</span>
      </h1>

      <!-- DESCRIPCIÓN -->
      <p class="hero-description">
        Este espacio documenta soluciones de ingeniería, aprendizajes y buenas prácticas en entornos híbridos y en la nube. Un recorrido técnico por la arquitectura de sistemas, la seguridad corporativa y la automatización aplicada.
      </p>

      <!-- CTA -->
      <div class="hero-cta">
        <a href="/blog" class="btn-primary">Explorar Artículos Técnicos</a>
      </div>

      <!-- CONTENEDOR DE TARJETAS (Estructura de 2 y 2 con presencia visual mejorada) -->
      <div class="hero-features-grid">
        
        <!-- Tarjeta 1 -->
        <a href="/blog?category=identidad" class="feature-card group">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <p class="feature-text">Gestión de identidad y directorios híbridos</p>
          <span class="feature-arrow">→</span>
        </a>

        <!-- Tarjeta 2 -->
        <a href="/blog?category=cloud" class="feature-card group">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 001-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <p class="feature-text">Modernización y migración a la nube</p>
          <span class="feature-arrow">→</span>
        </a>

        <!-- Tarjeta 3 -->
        <a href="/tools" class="feature-card group">
          <div class="feature-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="feature-text">Herramientas y utilitarios de diagnóstico</p>
          <span class="feature-arrow">→</span>
        </a>

        <!-- Tarjeta 4: Wallpapers (Icono de monitor moderno y llamativo en Cian) -->
        <a href="/wallpapers" class="feature-card visual-core-card group">
          <div class="feature-icon-wrapper cyan-glow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="feature-text cyan-text">Wallpapers & Ecosistema Visual</p>
          <span class="feature-arrow cyan-arrow">→</span>
        </a>

      </div>

    </div>
  </div>
</section>

<style>
  /* --- CONTENEDOR BASE --- */
  .hero-container {
    position: relative;
    width: 100%;
    padding: 3rem 0;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #000000; 
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  /* --- ENVOLTORIO DE FONDO --- */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    contain: layout paint; 
  }

  /* --- IMAGEN DE FONDO --- */
  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center; 
    filter: brightness(1.1) saturate(1.05);
  }

  /* --- LIENZO PROPORCIONAL 16:9 --- */
  .hero-canvas-art {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    max-width: 1920px;
    max-height: 1080px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 2;
  }

  /* --- ANCLAJE --- */
  .cpu-anchor {
    position: absolute;
    top: 87.0% !important;
    left: 51.0% !important;
    width: 60px;
    height: 500px;
    transform: translate(-50%, -100%);
    pointer-events: none;
    mix-blend-mode: screen;
    will-change: opacity, transform;
  }

  .cpu-core-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 20px;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 1) 0%, rgba(245, 158, 11, 0.9) 50%, transparent 100%);
    border-radius: 50%;
    animation: corePulse 2s infinite ease-in-out;
  }

  .light-beam {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 100%;
    background: linear-gradient(to top, 
      rgba(255, 255, 255, 1) 0%, 
      rgba(245, 158, 11, 0.9) 20%,
      rgba(56, 189, 248, 0.7) 50%, 
      transparent 90%
    );
    box-shadow: none;
    animation: beamFluctuation 2.5s infinite ease-in-out;
    transform-origin: bottom center;
  }

  @keyframes corePulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 0.9; }
    50% { transform: translateX(-50%) scale(1.2); opacity: 1; }
  }

  @keyframes beamFluctuation {
    0%, 100% {
      opacity: 0.7;
      transform: translateX(-50%) scaleX(0.9);
    }
    50% {
      opacity: 1;
      transform: translateX(-50%) scaleX(1.1);
    }
  }

  /* --- CONTENEDOR GENERAL --- */
  .hero-inner {
    width: 100% !important;
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    position: relative;
    z-index: 3;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
  }

  @media (min-width: 640px) {
    .hero-inner { padding-left: 2rem !important; padding-right: 2rem !important; }
  }

  @media (min-width: 1024px) {
    .hero-inner { padding-left: 3rem !important; padding-right: 3rem !important; }
  }

  .hero-content {
    width: 100% !important;
    max-width: 720px !important;
    text-align: left !important;
    z-index: 4;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0 !important;
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  .mobile-badge-container { display: none; }

  /* --- TÍTULO --- */
  .hero-title {
    font-size: clamp(1.5rem, 2vw, 2.1rem) !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    line-height: 1.2 !important;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
    margin: 0 0 1rem 0 !important;
    text-align: left !important;
  }

  .highlight { color: #f59e0b !important; }

  /* --- DESCRIPCIÓN --- */
  .hero-description {
    font-size: 0.95rem !important;
    font-weight: 400 !important;
    color: #cbd5e1 !important;
    line-height: 1.45 !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    margin: 0 0 1.25rem 0 !important;
    text-align: left !important;
  }

  /* --- CTA --- */
  .hero-cta { 
    margin: 0 0 1.25rem 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    text-align: left !important;
  }

  .btn-primary {
    display: inline-flex !important;
    width: auto !important;
    padding: 0.6rem 1.4rem !important;
    background-color: #f59e0b !important;
    color: #0f172a !important;
    font-weight: 700 !important;
    font-size: 0.9rem !important;
    text-align: center !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    position: relative;
    z-index: 5;
    transition: all 0.2s ease;
    border: none;
    box-shadow: none !important;
  }

  .btn-primary:hover {
    background-color: #d97706 !important;
    transform: translateY(-2px);
  }

  /* --- RETÍCULA DE TARJETAS (Fija 2x2 optimizada) --- */
  .hero-features-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 0.75rem !important;
    width: 100% !important;
    max-width: 660px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .feature-card {
    background: rgba(15, 23, 42, 0.88) !important;
    border: 1px solid rgba(245, 158, 11, 0.3) !important;
    border-radius: 10px !important;
    padding: 0.75rem 0.9rem !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.75rem !important;
    backdrop-filter: blur(8px) !important;
    text-decoration: none !important;
    transition: all 0.2s ease-in-out !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4) !important;
  }

  .feature-card:hover {
    background: rgba(15, 23, 42, 0.96) !important;
    border-color: rgba(245, 158, 11, 0.8) !important;
    transform: translateY(-2px) !important;
  }

  /* Estilos específicos para la tarjeta Visual Core (Cian Eléctrico) */
  .visual-core-card {
    border-color: rgba(0, 207, 255, 0.35) !important;
  }

  .visual-core-card:hover {
    border-color: rgba(0, 207, 255, 0.8) !important;
  }

  .cyan-glow {
    background: rgba(0, 207, 255, 0.15) !important;
    border: 1px solid rgba(0, 207, 255, 0.45) !important;
    color: #00CFFF !important;
  }

  .visual-core-card:hover .cyan-glow {
    background: rgba(0, 207, 255, 0.25) !important;
  }

  .cyan-arrow {
    color: #94a3b8;
  }

  .visual-core-card:hover .cyan-arrow {
    color: #00CFFF !important;
    transform: translateX(2px);
  }

  .cyan-text {
    color: #E8EEF5 !important;
  }

  .visual-core-card:hover .cyan-text {
    color: #00CFFF !important;
  }

  .feature-icon-wrapper {
    min-width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #f59e0b;
    flex-shrink: 0;
  }

  .feature-text {
    color: #E8EEF5 !important;
    font-size: 0.8rem !important;
    font-weight: 700 !important;
    line-height: 1.3 !important;
    margin: 0 !important;
    flex-grow: 1;
    transition: color 0.2s ease;
  }

  .feature-card:hover .feature-text {
    color: #ffffff !important;
  }

  .feature-arrow {
    color: #94a3b8;
    font-size: 0.8rem;
    font-family: monospace;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .feature-card:hover .feature-arrow {
    color: #f59e0b;
    transform: translateX(2px);
  }

  /* --- MEDIA QUERIES (Móvil y Tablets) --- */
  @media (max-width: 968px) {
    .hero-container {
      padding: 3rem 0;
      min-height: auto;
      background-color: #000000;
      border-bottom: 1px solid rgba(245, 158, 11, 0.2);
    }
    .hero-inner { 
      display: flex !important; 
      flex-direction: column !important; 
      z-index: 2 !important; 
      padding-left: 1rem !important; 
      padding-right: 1rem !important; 
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .hero-content { max-width: 100% !important; text-align: center !important; padding: 0 !important; gap: 0 !important; margin-left: auto !important; margin-right: auto !important; }
    .hero-bg-wrapper { display: none; }
    .mobile-badge-container { display: flex !important; justify-content: center; width: 100%; margin-bottom: 1rem; }
    .mobile-badge {
      width: 60px !important; height: 60px !important; border-radius: 1rem;
      background-color: rgba(15, 23, 42, 0.95); border: 1px solid rgba(245, 158, 11, 0.5);
      display: flex; align-items: center; justify-content: center; animation: subtle-pulse 3s infinite ease-in-out;
    }
    .hero-title { font-size: 1.6rem !important; line-height: 1.15 !important; text-shadow: 0 2px 8px rgba(0,0,0,1); text-align: center !important; margin: 0 0 1.25rem 0 !important; }
    .hero-description { font-size: 1rem !important; line-height: 1.5 !important; margin: 0 auto 1.5rem auto !important; color: #e2e8f0 !important; text-shadow: 0 2px 6px rgba(0,0,0,1); text-align: center !important; }
    .hero-cta { margin: 0 auto 1.5rem auto !important; text-align: center !important; }
    .btn-primary { display: inline-flex !important; width: auto !important; padding: 0.75rem 1.6rem !important; font-size: 0.95rem !important; border-radius: 10px !important; }
    
    .hero-features-grid { 
      grid-template-columns: 1fr !important; 
      max-width: 100% !important;
      gap: 0.5rem !important; 
    }
    .feature-card { 
      align-items: center !important; 
      text-align: left !important; 
    }
  }

  @keyframes subtle-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
</style>