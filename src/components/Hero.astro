---
// src/components/Hero.astro
import { Image } from 'astro:assets';
import heroBgImg from '../assets/images/hero-veyxara.webp';
---

<section class="hero-container">
  <!-- 1. CAPA DE NODOS INTERACTIVOS (Canvas Cyberpunk de Alto Contraste) -->
  <canvas id="hero-nodes-canvas" class="hero-nodes-canvas" aria-hidden="true"></canvas>

  <!-- 2. EFECTO DE ESCANEO LÁSER VERTICAL (Cyber Scanner) -->
  <div class="cyber-scanner" aria-hidden="true"></div>

  <!-- 3. FONDO Y DEGRADADO ORIGINAL (Vignette lateral limpio) -->
  <div class="hero-bg-wrapper">
    <div class="hero-gradient-overlay"></div>
    <Image 
      src={heroBgImg} 
      alt="Arquitectura de Infraestructura Global y Ecosistema Veyxara Core" 
      width={1920}
      height={1081}
      format="webp"
      quality={90}
      loading="eager" 
      fetchpriority="high"
      decoding="sync"
      class="hero-bg"
    />
  </div>

  <div class="hero-inner">
    <div class="hero-content">
      
      <!-- TÍTULO -->
      <h1 class="hero-title">
        Arquitectura y modernización de <span class="highlight-amber">infraestructura crítica</span> en <span class="highlight-cyan">entornos híbridos</span>
      </h1>

      <!-- DESCRIPCIÓN -->
      <p class="hero-description">
        Este espacio documenta <strong>soluciones de ingeniería</strong>, aprendizajes y buenas prácticas en entornos híbridos y en la nube. Un recorrido técnico por la arquitectura de sistemas, la seguridad corporativa y la automatización aplicada.
      </p>

      <!-- CTA -->
      <div class="hero-cta">
        <a href="/blog" class="btn-primary">Explorar Artículos Técnicos</a>
      </div>

      <!-- CONTENEDOR DE TARJETAS CON LASER PERIMETER HOVER -->
      <div class="hero-features-grid" id="features-grid">
        
        <!-- Tarjeta 1 -->
        <a href="/blog?category=identidad" class="feature-card group" data-laser-glow="#FF9900">
          <div class="laser-border"></div>
          <div class="feature-icon-wrapper amber-glow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <p class="feature-text">Gestión de identidad y directorios híbridos</p>
          <span class="feature-arrow amber-arrow">→</span>
        </a>

        <!-- Tarjeta 2 -->
        <a href="/blog?category=cloud" class="feature-card group" data-laser-glow="#FF9900">
          <div class="laser-border"></div>
          <div class="feature-icon-wrapper amber-glow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 001-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
            </svg>
          </div>
          <p class="feature-text">Modernización y migración a la nube</p>
          <span class="feature-arrow amber-arrow">→</span>
        </a>

        <!-- Tarjeta 3 -->
        <a href="/tools" class="feature-card group" data-laser-glow="#FF9900">
          <div class="laser-border"></div>
          <div class="feature-icon-wrapper amber-glow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="feature-text">Herramientas y utilitarios de diagnóstico</p>
          <span class="feature-arrow amber-arrow">→</span>
        </a>

        <!-- Tarjeta 4: Wallpapers -->
        <a href="/wallpapers" class="feature-card visual-core-card group" data-laser-glow="#00CFFF">
          <div class="laser-border"></div>
          <div class="feature-icon-wrapper cyan-glow">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="feature-text cyan-text">Wallpapers & Ecosistema Visual</p>
          <span class="feature-arrow cyan-arrow">→</span>
        </a>

      </div>

    </div>
  </div>
</section>

<style>
  /* --- CONTENEDOR BASE PROPORCIONAL (1920x1081) --- */
  .hero-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 1081;
    max-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: #071426; 
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    padding: 2.5rem 0;
  }

  /* --- CANVAS DE NODOS --- */
  .hero-nodes-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  /* --- CYBER SCANNER --- */
  .cyber-scanner {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0, 207, 255, 0.8), rgba(255, 153, 0, 0.8), transparent);
    z-index: 3;
    pointer-events: none;
    opacity: 0.4;
    box-shadow: 0 0 15px rgba(0, 207, 255, 0.6);
    animation: scanAnimation 8s ease-in-out infinite;
  }

  @keyframes scanAnimation {
    0% { transform: translateY(-10%); }
    50% { transform: translateY(110vh); }
    100% { transform: translateY(-10%); }
  }

  /* --- ENVOLTORIO DE FONDO --- */
  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  /* --- CAPA DE DEGRADADO ORIGINAL (Vignette lateral limpio) --- */
  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, rgba(7, 20, 38, 0.85) 0%, rgba(7, 20, 38, 0.4) 45%, rgba(7, 20, 38, 0.1) 70%, transparent 100%);
    pointer-events: none;
  }

  /* --- IMAGEN ÍNTEGRA 1920x1081 (Original, sin opacidades globales) --- */
  .hero-bg {
    width: 100%;
    height: 100%;
    object-fit: fill;
    object-position: center center;
    position: relative;
    z-index: 1;
  }

  /* --- CONTENEDOR DE CONTENIDO --- */
  .hero-inner {
    width: 100% !important;
    max-width: 1400px !important;
    margin-left: 0 !important;
    margin-right: auto !important;
    padding-left: 2rem !important;
    padding-right: 2rem !important;
    position: relative;
    z-index: 4;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
  }

  @media (min-width: 1024px) {
    .hero-inner { padding-left: 4rem !important; }
  }

  .hero-content {
    width: 100% !important;
    max-width: 680px !important; 
    text-align: left !important;
    z-index: 5;
    display: flex !important;
    flex-direction: column !important;
    margin-left: 0 !important;
    margin-right: auto !important;
  }

  .hero-title {
    font-size: clamp(1.5rem, 2.1vw, 2.3rem) !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    line-height: 1.25 !important;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem 0 !important;
    text-align: left !important;
  }

  .highlight-amber { color: #FF9900 !important; }
  .highlight-cyan { color: #00CFFF !important; }

  .hero-description {
    font-size: 1rem !important;
    font-weight: 400 !important;
    color: #E8EEF5 !important;
    line-height: 1.55 !important;
    margin: 0 0 1.5rem 0 !important;
    text-align: left !important;
  }

  .hero-description strong {
    color: #ffffff !important;
    font-weight: 600 !important;
  }

  .hero-cta { 
    margin: 0 0 1.75rem 0 !important;
    text-align: left !important;
  }

  .btn-primary {
    display: inline-flex !important;
    width: auto !important;
    padding: 0.75rem 1.6rem !important;
    background-color: #FF9900 !important;
    color: #071426 !important;
    font-weight: 700 !important;
    font-size: 0.92rem !important;
    text-align: center !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    transition: all 0.2s ease;
    border: none;
    box-shadow: 0 4px 14px rgba(255, 153, 0, 0.35) !important;
  }

  .btn-primary:hover {
    background-color: #e68a00 !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 153, 0, 0.5) !important;
  }

  .hero-features-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 0.75rem !important;
    width: 100% !important;
    max-width: 650px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .feature-card {
    position: relative;
    background: rgba(23, 29, 39, 0.92) !important;
    border: 1px solid rgba(255, 153, 0, 0.35) !important;
    border-radius: 10px !important;
    padding: 0.75rem 0.95rem !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.7rem !important;
    backdrop-filter: blur(10px) !important;
    text-decoration: none !important;
    transition: transform 0.2s ease-in-out, background 0.2s ease-in-out !important;
    box-shadow: 0 4px 16px rgba(7, 20, 38, 0.6) !important;
    overflow: hidden;
  }

  .laser-border {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      400px circle at var(--mouse-x) var(--mouse-y),
      var(--laser-color, rgba(255, 153, 0, 0.9)) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .feature-card:hover .laser-border { opacity: 1; }

  .feature-card::after {
    content: '';
    position: absolute;
    inset: 1px;
    background: rgba(23, 29, 39, 0.95);
    border-radius: 9px;
    z-index: 2;
  }

  .feature-card > * { position: relative; z-index: 3; }
  .feature-card:hover { transform: translateY(-2px) !important; }

  .visual-core-card { border-color: rgba(0, 207, 255, 0.4) !important; }

  .amber-glow {
    background: rgba(255, 153, 0, 0.15) !important;
    border: 1px solid rgba(255, 153, 0, 0.4) !important;
    color: #FF9900 !important;
  }

  .cyan-glow {
    background: rgba(0, 207, 255, 0.15) !important;
    border: 1px solid rgba(0, 207, 255, 0.45) !important;
    color: #00CFFF !important;
  }

  .visual-core-card:hover .cyan-glow { background: rgba(0, 207, 255, 0.25) !important; }

  .amber-arrow { color: #94a3b8; }
  .feature-card:hover .amber-arrow { color: #FF9900 !important; transform: translateX(2px); }

  .cyan-arrow { color: #94a3b8; }
  .visual-core-card:hover .cyan-arrow { color: #00CFFF !important; transform: translateX(2px); }

  .cyan-text { color: #E8EEF5 !important; }
  .visual-core-card:hover .cyan-text { color: #00CFFF !important; }

  .feature-icon-wrapper {
    min-width: 35px;
    height: 35px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-text {
    color: #E8EEF5 !important;
    font-size: 0.82rem !important;
    font-weight: 700 !important;
    line-height: 1.35 !important;
    margin: 0 !important;
    flex-grow: 1;
    transition: color 0.2s ease;
  }

  .feature-card:hover .feature-text { color: #ffffff !important; }
  .feature-arrow { font-size: 0.82rem; font-family: monospace; flex-shrink: 0; transition: transform 0.2s ease; }

  @media (max-width: 968px) {
    .hero-container { aspect-ratio: auto; padding: 2.5rem 0; min-height: auto; background-color: #071426; border-bottom: 1px solid rgba(255, 153, 0, 0.2); }
    .hero-inner { padding-left: 1.25rem !important; padding-right: 1.25rem !important; margin-left: auto !important; margin-right: auto !important; }
    .hero-content { max-width: 100% !important; text-align: center !important; margin-left: auto !important; margin-right: auto !important; }
    .hero-bg-wrapper, .hero-nodes-canvas, .cyber-scanner { display: none; }
    .hero-title { font-size: 1.6rem !important; line-height: 1.2 !important; text-align: center !important; margin: 0 0 1.25rem 0 !important; }
    .hero-description { font-size: 0.98rem !important; line-height: 1.55 !important; margin: 0 auto 1.25rem auto !important; text-align: center !important; }
    .hero-cta { margin: 0 auto 1.5rem auto !important; text-align: center !important; }
    .btn-primary { display: inline-flex !important; width: auto !important; padding: 0.75rem 1.6rem !important; font-size: 0.95rem !important; border-radius: 10px !important; }
    .hero-features-grid { grid-template-columns: 1fr !important; max-width: 100% !important; gap: 0.75rem !important; }
    .feature-card { align-items: center !important; text-align: left !important; }
  }
</style>

<script>
  function initHeroModule() {
    const canvas = document.getElementById('hero-nodes-canvas') as HTMLCanvasElement;
    let animationFrameId: number;
    let handleResize: (() => void) | undefined;
    let onMouseMove: ((e: MouseEvent) => void) | undefined;
    let onMouseLeave: (() => void) | undefined;
    let heroSection: Element | null = null;

    if (canvas) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        let width = (canvas.width = canvas.offsetWidth);
        let height = (canvas.height = canvas.offsetHeight);

        handleResize = () => {
          if (!canvas) return;
          width = canvas.width = canvas.offsetWidth;
          height = canvas.height = canvas.offsetHeight;
        };
        window.addEventListener('resize', handleResize);

        const particleCount = Math.floor((width * height) / 18000);
        const maxDistance = 130;
        const particles: Array<{
          x: number;
          y: number;
          vx: number;
          vy: number;
          radius: number;
        }> = [];

        for (let i = 0; i < Math.max(30, Math.min(particleCount, 70)); i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.5,
            vy: (Math.random() - 0.5) * 0.5,
            radius: Math.random() * 1.8 + 1.2
          });
        }

        let mouseX = -1000;
        let mouseY = -1000;

        heroSection = canvas.closest('.hero-container');
        onMouseMove = (e: MouseEvent) => {
          const rect = canvas.getBoundingClientRect();
          mouseX = e.clientX - rect.left;
          mouseY = e.clientY - rect.top;
        };
        onMouseLeave = () => {
          mouseX = -1000;
          mouseY = -1000;
        };

        if (heroSection) {
          heroSection.addEventListener('mousemove', onMouseMove as EventListener);
          heroSection.addEventListener('mouseleave', onMouseLeave);
        }

        const render = () => {
          ctx.clearRect(0, 0, width, height);

          for (let i = 0; i < particles.length; i++) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < 0 || p.x > width) p.vx *= -1;
            if (p.y < 0 || p.y > height) p.vy *= -1;

            // Nodos principales en Ámbar (#FF9900) con brillo para resaltar perfectamente sobre la mano azul
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 153, 0, 0.9)';
            ctx.shadowColor = '#FF9900';
            ctx.shadowBlur = 5;
            ctx.fill();
            ctx.shadowBlur = 0;

            for (let j = i + 1; j < particles.length; j++) {
              const p2 = particles[j];
              const dx = p.x - p2.x;
              const dy = p.y - p2.y;
              const dist = Math.sqrt(dx * dx + dy * dy);

              if (dist < maxDistance) {
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p2.x, p2.y);
                const alpha = (1 - dist / maxDistance) * 0.35;
                // Conexiones en Cian Eléctrico (#00CFFF)
                ctx.strokeStyle = `rgba(0, 207, 255, ${alpha})`;
                ctx.lineWidth = 1;
                ctx.stroke();
              }
            }

            const distMouse = Math.sqrt((p.x - mouseX) ** 2 + (p.y - mouseY) ** 2);
            if (distMouse < 160) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(mouseX, mouseY);
              const mouseAlpha = (1 - distMouse / 160) * 0.5;
              ctx.strokeStyle = `rgba(255, 153, 0, ${mouseAlpha})`;
              ctx.lineWidth = 1.2;
              ctx.stroke();
            }
          }

          animationFrameId = requestAnimationFrame(render);
        };

        render();
      }
    }

    const cards = document.querySelectorAll('.feature-card');
    const cardHandlers = new Map<HTMLElement, (e: MouseEvent) => void>();

    cards.forEach((card) => {
      const htmlCard = card as HTMLElement;
      const glowColor = htmlCard.getAttribute('data-laser-glow') || 'rgba(255, 153, 0, 0.9)';
      htmlCard.style.setProperty('--laser-color', glowColor);

      const handleCardMouseMove = (e: MouseEvent) => {
        const rect = htmlCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        htmlCard.style.setProperty('--mouse-x', `${x}px`);
        htmlCard.style.setProperty('--mouse-y', `${y}px`);
      };

      htmlCard.addEventListener('mousemove', handleCardMouseMove as EventListener);
      cardHandlers.set(htmlCard, handleCardMouseMove);
    });

    return () => {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      if (handleResize) window.removeEventListener('resize', handleResize);
      if (heroSection && onMouseMove && onMouseLeave) {
        heroSection.removeEventListener('mousemove', onMouseMove as EventListener);
        heroSection.removeEventListener('mouseleave', onMouseLeave);
      }
      cardHandlers.forEach((handler, card) => {
        card.removeEventListener('mousemove', handler as EventListener);
      });
    };
  }

  let cleanup = initHeroModule();

  document.addEventListener('astro:after-swap', () => {
    if (cleanup) cleanup();
    cleanup = initHeroModule();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      if (cleanup) cleanup();
      cleanup = initHeroModule();
    });
  }
</script>