---
// src/components/Services.astro
const services = [
  {
    category: "SEGURIDAD, IDENTIDAD & HARDENING",
    title: "Gobierno & Microsoft 365",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>`,
    items: ["Microsoft 365 & Entra ID", "Políticas ASR & Defender", "Gobierno PIM & Acceso", "Análisis de Correo & Cabeceras", "Gestión de Vulnerabilidades"],
    cta: "Explorar Artículos & Blog",
    href: "/blog"
  },
  {
    category: "OPERACIONES & NIVEL 3",
    title: "Automatización & Scripts",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756-2.924 0-3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
    items: ["PowerShell & Scripting Avanzado", "Troubleshooting Nivel 3", "Active Directory & GPOs", "Patch Management & Recovery", "Utilitarios de Diagnóstico Libre"],
    cta: "Ver Herramientas y Utilitarios",
    href: "/tools"
  },
  {
    category: "INFRAESTRUCTURA & NUBE",
    title: "Entornos Híbridos",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-cyan-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>`,
    items: ["Migración a Windows Server 2025", "Azure Cloud & VNet Peering", "Servidores On-Premises", "VPNs Site-to-Site & Redes", "Alta Disponibilidad & Resiliencia"],
    cta: "Ver Documentación Técnica",
    href: "/blog"
  }
];
---

<section id="servicios" class="w-full min-h-[calc(100vh-76px)] pt-24 pb-12 px-4 sm:px-6 bg-[#cbd5e1] border-t border-zinc-300 flex flex-col justify-center items-center scroll-mt-28">
  <div class="max-w-6xl mx-auto space-y-8 w-full my-auto">
    
    <!-- Encabezado Proporcionado -->
    <div class="text-center space-y-2">
      <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 tracking-tight uppercase">
        Bitácora Técnica & Recursos de Ingeniería
      </h2>
      <p class="text-zinc-700 font-medium text-xs sm:text-sm max-w-2xl mx-auto">
        Espacio personal de documentación, intercambio de vivencias y utilitarios de análisis orientados a infraestructura crítica y seguridad.
      </p>
    </div>
    
    <!-- Tarjetas Claras con Categorías Corregidas -->
    <div class="grid md:grid-cols-3 gap-6">
      {services.map((service) => (
        <article class="bg-white border border-zinc-300 rounded-xl overflow-hidden shadow-md shadow-zinc-400/20 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
          
          <!-- Consola Header Bar Sutil -->
          <div class="bg-slate-800 px-4 py-2 flex items-center justify-between border-b border-slate-700">
            <div class="flex items-center space-x-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
            </div>
            <span class="text-[10px] font-mono text-cyan-300 tracking-wider uppercase">Veyxara // Lab</span>
          </div>

          <div class="p-6 space-y-4">
            <!-- Icono -->
            <div class="flex justify-center">
              <div class="w-11 h-11 rounded-lg bg-cyan-50 border border-cyan-200 flex items-center justify-center shadow-xs">
                <Fragment set:html={service.iconSvg} />
              </div>
            </div>

            <!-- Títulos y Categoría con Mayor Legibilidad -->
            <div class="space-y-1.5 text-center">
              <span class="text-xs font-mono font-extrabold text-cyan-900 uppercase tracking-wider block">
                {service.category}
              </span>
              <h3 class="text-base font-bold text-zinc-900 leading-snug">
                {service.title}
              </h3>
            </div>

            <hr class="border-zinc-200 my-2" />
            
            <!-- Checklist de Contenidos -->
            <ul class="space-y-2 text-zinc-700 text-xs font-medium text-left w-full pl-1">
              {service.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="text-amber-500 font-extrabold shrink-0" aria-hidden="true">✓</span> 
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          
          <!-- Botón Gris Oscuro Sobrio -->
          <div class="p-6 pt-0">
            <a 
              href={service.href} 
              class="block w-full bg-zinc-900 hover:bg-zinc-800 text-white font-bold text-center py-2.5 rounded-lg transition-all duration-200 shadow-sm text-xs sm:text-sm"
            >
              {service.cta}
            </a>
          </div>

        </article>
      ))}
    </div>
  </div>
</section>