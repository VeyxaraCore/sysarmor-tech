---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    number: "01",
    title: "Recolección de Información",
    content: "En Veyxara Core recopilamos únicamente la información estrictamente necesaria para responder a consultas técnicas. Los datos recolectados a través de nuestros canales de contacto incluyen: nombre, dirección de correo electrónico y detalles técnicos suministrados voluntariamente por el usuario."
  },
  {
    number: "02",
    title: "Uso de la Información",
    intro: "La información recolectada se utiliza de forma exclusiva para:",
    items: [
      "Responder a consultas técnicas, dudas sobre artículos o comentarios en el blog.",
      "Coordinar discusiones de arquitectura, retroalimentación de scripts o colaboración en proyectos abiertos.",
      "Mejorar la calidad de las guías y herramientas técnicas publicadas."
    ]
  },
  {
    number: "03",
    title: "Uso de Herramientas Técnicas (Client-Side Processing)",
    content: "Las herramientas interactivas y utilidades de ingeniería proporcionadas en nuestro portal operan de forma exclusiva en el lado del cliente mediante scripts de ejecución local en el navegador del usuario. Ningún dato técnico, cadena de configuración, parámetro introducido ni resultado de diagnóstico es transmitido, almacenado, registrado en logs ni procesado en servidores externos, garantizando la confidencialidad absoluta de sus entornos."
  },
  {
    number: "04",
    title: "Derechos del Titular (Habeas Data)",
    content: "De conformidad con la normativa de protección de datos personales, usted tiene derecho a conocer, actualizar, rectificar y solicitar la supresión de sus datos de nuestros registros en cualquier momento enviando una solicitud a nuestro canal de contacto oficial:"
  }
];
---

<Layout title="Política de Privacidad | Veyxara Core" variant="legal" bgColor="#cbd5e1">
  <div class="w-full min-h-screen py-12 px-4 sm:px-6 lg:px-8 bg-[#cbd5e1] flex flex-col justify-center items-center">
    <article class="max-w-4xl w-full mx-auto">
      
      <!-- Botón de retorno limpio -->
      <div class="mb-6">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-slate-900 bg-slate-200/90 hover:bg-amber-400 border border-slate-400 hover:border-amber-500 px-4 py-2.5 rounded-lg shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-amber-500 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver al Inicio
        </a>
      </div>

      <!-- Header principal estilo tarjeta técnica -->
      <header class="bg-slate-900 text-white border-l-4 border-amber-400 rounded-r-2xl p-6 sm:p-8 mb-8 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
          <span class="bg-amber-400/20 text-amber-300 font-mono text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-md border border-amber-400/40">
            Legal & Compliance
          </span>
          <p class="text-xs font-mono text-slate-400">
            Última actualización: Septiembre 2026
          </p>
        </div>
        <h1 class="text-3xl sm:text-4xl font-display font-extrabold tracking-tight text-white">
          Política de Privacidad
        </h1>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">
          Transparencia y seguridad en el tratamiento de tus datos y entornos técnicos en Veyxara.
        </p>
      </header>

      <!-- Bloques de secciones con alto contraste -->
      <div class="space-y-6">
        
        <!-- Sección 01 -->
        <section class="bg-slate-100/90 hover:bg-white p-6 sm:p-8 rounded-xl border border-slate-300 hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg bg-slate-900 text-amber-400 font-mono font-bold text-sm shadow-xs">
              {sections[0].number}
            </span>
            <div>
              <h2 class="font-display font-bold text-lg text-slate-900 mb-2">
                {sections[0].title}
              </h2>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
                {sections[0].content}
              </p>
            </div>
          </div>
        </section>

        <!-- Sección 02 -->
        <section class="bg-slate-100/90 hover:bg-white p-6 sm:p-8 rounded-xl border border-slate-300 hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg bg-slate-900 text-amber-400 font-mono font-bold text-sm shadow-xs">
              {sections[1].number}
            </span>
            <div class="w-full">
              <h2 class="font-display font-bold text-lg text-slate-900 mb-2">
                {sections[1].title}
              </h2>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal mb-4">
                {sections[1].intro}
              </p>
              <ul class="space-y-2.5">
                {sections[1].items?.map((item) => (
                  <li class="flex items-start gap-3 bg-slate-200/60 p-3 rounded-lg border border-slate-300/80">
                    <span class="text-amber-600 font-bold text-sm leading-none mt-0.5">✓</span>
                    <span class="font-medium text-slate-800 text-xs sm:text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>

        <!-- Sección 03 -->
        <section class="bg-slate-100/90 hover:bg-white p-6 sm:p-8 rounded-xl border border-slate-300 hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg bg-slate-900 text-amber-400 font-mono font-bold text-sm shadow-xs">
              {sections[2].number}
            </span>
            <div>
              <h2 class="font-display font-bold text-lg text-slate-900 mb-2">
                {sections[2].title}
              </h2>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
                {sections[2].content}
              </p>
            </div>
          </div>
        </section>

        <!-- Sección 04 -->
        <section class="bg-slate-100/90 hover:bg-white p-6 sm:p-8 rounded-xl border border-slate-300 hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg bg-slate-900 text-amber-400 font-mono font-bold text-sm shadow-xs">
              {sections[3].number}
            </span>
            <div class="w-full">
              <h2 class="font-display font-bold text-lg text-slate-900 mb-2">
                {sections[3].title}
              </h2>
              <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal mb-4">
                {sections[3].content}
              </p>
              <a 
                href="mailto:contacto@veyxara.com" 
                class="inline-flex items-center gap-2 font-mono text-xs sm:text-sm font-bold text-slate-900 bg-amber-400 hover:bg-amber-500 px-4 py-2.5 rounded-lg border border-amber-500 shadow-xs transition-colors focus:outline-none focus:ring-2 focus:ring-amber-500"
              >
                ✉️ contacto@veyxara.com
              </a>
            </div>
          </div>
        </section>

        <!-- Bloque de aviso final -->
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl shadow-lg text-center mt-8">
          <p class="font-mono text-xs sm:text-sm text-slate-300 leading-relaxed">
            <span class="text-amber-400 font-bold">VEYXARA CORE:</span> Portal de divulgación técnica e ingeniería abierta. No comercializamos, alquilamos ni compartimos datos personales con terceros.
          </p>
        </div>

      </div>

    </article>
  </div>
</Layout>