---
import Layout from '../layouts/Layout.astro';

const sections = [
  {
    number: "01",
    title: "Naturaleza del Portal y Contenido Técnico",
    content: "Veyxara Core es un portal de divulgación técnica, arquitectura de infraestructura y recursos de ingeniería abierta. Los artículos, guías, scripts de automatización y documentación compartidos tienen un propósito educativo y de referencia profesional, basados en buenas prácticas de la industria."
  },
  {
    number: "02",
    title: "Uso de Herramientas y Utilidades Técnicas",
    content: "Las herramientas web y utilidades interactivas provistas en este sitio se ofrecen de manera libre y sin costo con fines de diagnóstico. Dichas herramientas se ejecutan de forma local en el navegador del usuario (client-side). Veyxara Core no garantiza la infalibilidad absoluta de los cálculos o análisis arrojados ni asume responsabilidad por decisiones de configuración tomadas en infraestructura de producción basadas exclusivamente en dichos resultados, siendo responsabilidad final del administrador verificar su entorno."
  },
  {
    number: "03",
    title: "Responsabilidad sobre Entornos de Producción",
    content: "Como ingenieros de infraestructura, promovemos principios de seguridad y resiliencia (hardening, respaldos y pruebas en entornos de laboratorio). El visitante o administrador de sistemas es el único responsable de validar, respaldar y aplicar cualquier script, configuración o recomendación expuesta en este sitio web sobre sus propias plataformas productivas."
  },
  {
    number: "04",
    title: "Propiedad Intelectual",
    content: "Los artículos, códigos fuente, herramientas propias, isotipos y estructura visual publicados en Veyxara Core son propiedad intelectual de la firma. Se permite su consulta libre, uso técnico y compartición referenciando la autoría original, quedando prohibida su comercialización directa por terceros."
  }
];
---

<Layout title="Términos del Servicio | Veyxara Core" variant="legal" bgColor="#cbd5e1">
  <div class="w-full min-h-screen py-12 px-4 sm:px-6 lg:px-8 bg-[#cbd5e1] flex flex-col justify-center items-center">
    <article class="max-w-4xl w-full mx-auto">
      
      <!-- Botón de retorno limpio -->
      <div class="mb-6">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-slate-900 bg-slate-200/90 hover:bg-amber-400 border border-slate-400 hover:border-amber-500 px-4 py-2.5 rounded-lg shadow-sm transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-amber-500 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver al Inicio
        </a>
      </div>

      <!-- Header principal estilo tarjeta técnica -->
      <header class="bg-slate-900 text-white border-l-4 border-amber-400 rounded-r-2xl p-6 sm:p-8 mb-8 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-3">
          <span class="bg-amber-400/20 text-amber-300 font-mono text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-md border border-amber-400/40">
            Términos & Condiciones
          </span>
          <p class="text-xs font-mono text-slate-400">
            Última actualización: Septiembre 2026
          </p>
        </div>
        <h1 class="text-3xl sm:text-4xl font-display font-extrabold tracking-tight text-white">
          Términos de Uso y Divulgación
        </h1>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">
          Lineamientos operativos, responsabilidad sobre entornos y propiedad intelectual de Veyxara.
        </p>
      </header>

      <!-- Bloques de secciones con alto contraste -->
      <div class="space-y-6">
        {sections.map((section) => (
          <section class="bg-slate-100/90 hover:bg-white p-6 sm:p-8 rounded-xl border border-slate-300 hover:border-slate-400 shadow-sm hover:shadow-md transition-all duration-200">
            <div class="flex items-start gap-4">
              <span class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-lg bg-slate-900 text-amber-400 font-mono font-bold text-sm shadow-xs">
                {section.number}
              </span>
              <div>
                <h2 class="font-display font-bold text-lg text-slate-900 mb-2">
                  {section.title}
                </h2>
                <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal">
                  {section.content}
                </p>
              </div>
            </div>
          </section>
        ))}

        <!-- Bloque de aviso final -->
        <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl shadow-lg text-center mt-8">
          <p class="font-mono text-xs sm:text-sm text-slate-300 leading-relaxed">
            <span class="text-amber-400 font-bold">AVISO:</span> El uso continuo de este sitio web y sus utilidades implica la aceptación formal de estos términos operativos y de divulgación.
          </p>
        </div>
      </div>

    </article>
  </div>
</Layout>