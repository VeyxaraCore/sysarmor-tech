---
// src/pages/tools/index.astro
import Layout from '../../layouts/Layout.astro';

// Metadatos SEO optimizados para la página de utilidades e infraestructura
const seoTitle = "Herramientas de Infraestructura IT, Redes y Ciberseguridad | Veyxara Lab";
const seoDescription = "Colección de utilidades técnicas para ingenieros de sistemas y administradores de infraestructura: calculadoras VLSM/CIDR, validadores SPF/DKIM/DMARC, auditoría DNS y seguridad SSL.";
const seoCanonical = "https://veyxara.com/tools";

// Definimos los iconos SVG únicamente para las tarjetas de herramientas
const icons = {
  redirect: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>',
  calculator: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="10" y2="10"/><line x1="14" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="10" y2="14"/><line x1="14" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="10" y2="18"/><line x1="14" y1="18" x2="16" y2="18"/></svg>',
  cidr: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 010 18M12 3a15.3 15.3 0 000 18"/></svg>',
  port: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>',
  ip: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>',
  cloud: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>',
  shield: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>',
  mail: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>',
  key: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>',
  code: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>',
  search: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>',
  document: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>',
  warning: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>',
  report: '<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:text-cyan-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>'
};

const redTools = [
  {
    title: "Auditor de Cadenas de Redirección",
    description: "Inspecciona cada salto (hop), detecta redirecciones temporales erróneas (302) y protege tu posicionamiento SEO.",
    href: "/tools/redirect-chain",
    badge: "Infraestructura & SEO",
    svgIcon: icons.redirect
  },
  {
    title: "Calculadora VLSM (IPv4)",
    description: "Diseña subredes IP de tamaño variable de forma eficiente y optimiza el direccionamiento IPv4.",
    href: "/tools/vlsm",
    badge: "Redes IPv4",
    svgIcon: icons.calculator
  },
  {
    title: "Calculadora CIDR (IPv4)",
    description: "Desglosa bloques de red en notación CIDR para obtener máscaras y rangos de hosts útiles.",
    href: "/tools/cidr",
    badge: "Redes IPv4",
    svgIcon: icons.cidr
  },
  {
    title: "Calculadora de Subredes (IPv6)",
    description: "Distribuye y planifica bloques jerárquicos de red IPv6 por requerimientos de subred o dispositivos.",
    href: "/tools/ipv6-subnetting",
    badge: "Redes IPv6",
    svgIcon: icons.calculator
  },
  {
    title: "Calculadora CIDR IPv6",
    description: "Analiza prefijos y bloques jerárquicos de red IPv6 con soporte para expansión de ceros.",
    href: "/tools/ipv6-cidr",
    badge: "Redes IPv6",
    svgIcon: icons.cidr
  },
  {
    title: "Comprobador de Puertos TCP",
    description: "Verifica disponibilidad y estado de puertos específicos mediante conexión TCP (Handshake).",
    href: "/tools/port-checker",
    badge: "Redes & Sockets",
    svgIcon: icons.port
  },
  {
    title: "¿Cuál es mi IP?",
    description: "Visualiza tu dirección IP pública actual, navegador y detalles de red de forma rápida y directa.",
    href: "/tools/what-is-my-ip",
    badge: "Redes",
    svgIcon: icons.ip
  }
];

const cloudTools = [
  {
    title: "Matriz de Equivalencias Multi-Cloud",
    description: "Traducción directa de arquitecturas, servicios de red, cómputo y ciberseguridad entre Microsoft Azure, AWS y GCP.",
    href: "/tools/cloud-matrix",
    badge: "Arquitectura Cloud",
    svgIcon: icons.cloud
  }
];

const emailTools = [
  {
    title: "Auditoría de Salud DNS y Correo",
    description: "Analiza la salud general de servidores DNS (NS, MX) y configuraciones de seguridad (SPF, DMARC).",
    href: "/tools/dns-health-audit",
    badge: "Diagnóstico DNS",
    svgIcon: icons.ip
  },
  {
    title: "Validador de Registros MX",
    description: "Verifica los servidores de correo electrónico configurados y su jerarquía de prioridad para dominios.",
    href: "/tools/mx",
    badge: "DNS & Correo",
    svgIcon: icons.mail
  },
  {
    title: "Validador de Registro SPF",
    description: "Inspecciona los registros TXT y valida la sintaxis de las políticas SPF para proteger tu dominio.",
    href: "/tools/spf",
    badge: "Seguridad & DNS",
    svgIcon: icons.shield
  },
  {
    title: "Validador de Registro DKIM",
    description: "Comprueba la clave pública y la integridad de los registros DKIM bajo selectores personalizados.",
    href: "/tools/dkim-checker",
    badge: "Seguridad & DNS",
    svgIcon: icons.key
  },
  {
    title: "Validador DMARC",
    description: "Audita la política de autenticación, reporte y conformidad de correo electrónico de tus dominios.",
    href: "/tools/dmarc-checker",
    badge: "Seguridad & DNS",
    svgIcon: icons.mail
  },
  {
    title: "Generador de Registros DMARC",
    description: "Construye cadenas de texto para registros DNS TXT de DMARC con soporte para políticas.",
    href: "/tools/dmarc-generator",
    badge: "Seguridad & Correo",
    svgIcon: icons.mail
  },
  {
    title: "Analizador de Cabeceras de Correo",
    description: "Inspecciona saltos de red detallados, latencias y validaciones SPF, DKIM y DMARC.",
    href: "/tools/email-analyzer",
    badge: "Seguridad & M365",
    svgIcon: icons.mail
  }
];

const securityWebTools = [
  {
    title: "Analizador de Cabeceras HTTP / HTTPS",
    description: "Audita cabeceras de respuesta de servidores bajo protocolos seguros TLS/SSL.",
    href: "/tools/http-headers",
    badge: "Seguridad Web",
    svgIcon: icons.code
  },
  {
    title: "Validador de Certificados X.509",
    description: "Analiza la validez, vigencia, emisor y propiedades criptográficas de certificados SSL/TLS en PEM.",
    href: "/tools/certificate-validator",
    badge: "Seguridad & SSL",
    svgIcon: icons.shield
  },
  {
    title: "Generador de Solicitudes CSR",
    description: "Genera pares de claves criptográficas y solicitudes de firma de certificados X.509 (CSR) de forma local en el navegador.",
    href: "/tools/csr-generator",
    badge: "Seguridad & SSL",
    svgIcon: icons.key
  },
  {
    title: "Generador de Claves y Contraseñas",
    description: "Crea claves robustas y contraseñas seguras utilizando entropía nativa del navegador de forma local.",
    href: "/tools/key-generator",
    badge: "Seguridad & Criptografía",
    svgIcon: icons.key
  },
  {
    title: "Validador Oficial Spamhaus DQS",
    description: "Consulta la reputación de dominios e IPs en tiempo real frente al DQS de Spamhaus, Google Safe Browsing y PhishTank.",
    href: "/tools/spamhaus-checker",
    badge: "Seguridad & DNS",
    svgIcon: icons.warning
  },
  {
    title: "Reporte Ejecutivo de Seguridad",
    description: "Consolidado multi-herramienta de hardening, análisis de protocolos de transporte y conformidad global.",
    href: "/tools/report",
    badge: "Auditoría Global",
    svgIcon: icons.report
  }
];

const whoisTools = [
  {
    title: "Buscador WHOIS de Dominios",
    description: "Consulta información de registro, fechas de expiración y servidores de nombres en tiempo real.",
    href: "/tools/whois",
    badge: "Redes & DNS",
    svgIcon: icons.search
  },
  {
    title: "Verificador de Registros PTR (rDNS)",
    description: "Valida el DNS inverso de IPs de envío SMTP para prevenir bloqueos de correo y asegurar la entregabilidad.",
    href: "/tools/ptr-checker",
    badge: "Correo & rDNS",
    svgIcon: icons.document
  }
];

const renderCards = (toolsList: typeof redTools) => {
  return toolsList.map((tool) => `
    <article class="rounded-xl p-5 border border-zinc-300 transition-all duration-300 flex flex-col justify-between space-y-4 bg-white shadow-xs hover:border-cyan-700 hover:shadow-md hover:-translate-y-0.5 relative overflow-hidden group">
      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="p-2 bg-slate-900 border border-slate-700 rounded-lg shrink-0 flex items-center justify-center shadow-xs group-hover:bg-cyan-900 group-hover:border-cyan-700 transition-colors">
            ${tool.svgIcon}
          </div>
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-md bg-zinc-100 border border-zinc-300 text-zinc-700 shadow-xs">
              ${tool.badge}
            </span>
          </div>
        </div>
        <div class="space-y-1">
          <h3 class="font-display font-bold tracking-tight text-neutral-900 text-sm sm:text-base group-hover:text-cyan-900 transition-colors uppercase">
            <a href="${tool.href}" class="focus:outline-none focus:ring-0 focus-visible:outline-none before:absolute before:inset-0 before:z-10">
              ${tool.title}
            </a>
          </h3>
          <p class="text-xs sm:text-sm text-zinc-600 line-clamp-2 leading-relaxed font-sans">
            ${tool.description}
          </p>
        </div>
      </div>
    </article>
  `).join('');
};
---

<Layout title={seoTitle} description={seoDescription} canonical={seoCanonical}>
  <main class="w-full min-h-[calc(100vh-76px)] py-8 px-4 sm:px-6 bg-[#cbd5e1] text-neutral-900 border-t border-zinc-300">
    <div class="max-w-5xl mx-auto space-y-10">
      
      <!-- HERO BANNER ENMARCADO EN CONSOLA OSCURA -->
      <section class="w-full">
        <div class="bg-[#0f172a] border border-slate-700/80 rounded-2xl overflow-hidden shadow-xl shadow-slate-900/15 text-white">
          
          <!-- Barrita Superior de Terminal -->
          <div class="bg-[#1e293b] px-4 py-2.5 flex items-center justify-between border-b border-slate-700/60">
            <div class="flex items-center space-x-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/80 inline-block"></span>
            </div>
            <span class="text-[11px] font-mono font-bold text-cyan-400 tracking-wider uppercase">
              Veyxara // System Utilities & Lab Tools
            </span>
          </div>

          <!-- Contenido Interior del Hero -->
          <div class="p-6 md:p-8 space-y-5 text-center max-w-3xl mx-auto">
            
            <div class="space-y-2">
              <span class="text-xs font-mono font-extrabold text-amber-400 uppercase tracking-widest block">
                HERRAMIENTAS & UTILITARIOS TI
              </span>
              <h1 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight uppercase">
                Herramientas de Veyxara Tools
              </h1>
              <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-sans font-medium max-w-2xl mx-auto">
                Utilidades propias desarrolladas como proyectos personales, pensadas para ingenieros de sistemas y administradores de infraestructura IT.
              </p>
            </div>

            <!-- Alerta de Privacidad Estilo Badge de Seguridad -->
            <div class="bg-slate-900/90 border border-amber-500/40 rounded-xl p-3.5 inline-flex items-center justify-center gap-3 text-left max-w-xl mx-auto shadow-inner">
              <span class="p-2 rounded-lg bg-amber-500/10 text-amber-400 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <p class="text-[11px] sm:text-xs text-slate-300 font-mono leading-tight">
                <strong class="text-amber-400 uppercase font-bold block mb-0.5">Procesamiento Local:</strong>
                Los datos y parámetros ingresados son de ejecución temporal en tu navegador: no se almacenan ni se registran en servidores.
              </p>
            </div>

          </div>

        </div>
      </section>

      <!-- SECCIÓN 1: Redes e Infraestructura IP -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-display font-bold text-neutral-900 uppercase tracking-wide flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-amber-700">// 01</span>
          Redes e Infraestructura IP
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-1" set:html={renderCards(redTools)} />
      </section>

      <!-- SECCIÓN 2: Arquitectura Cloud e Infraestructura Híbrida -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-display font-bold text-neutral-900 uppercase tracking-wide flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-amber-700">// 02</span>
          Arquitectura Cloud e Infraestructura Híbrida
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-1" set:html={renderCards(cloudTools)} />
      </section>

      <!-- SECCIÓN 3: Correo Electrónico y Autenticación -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-display font-bold text-neutral-900 uppercase tracking-wide flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-amber-700">// 03</span>
          Correo Electrónico y Autenticación (SPF/DKIM/DMARC)
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-1" set:html={renderCards(emailTools)} />
      </section>

      <!-- SECCIÓN 4: Seguridad Web y Certificados -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-display font-bold text-neutral-900 uppercase tracking-wide flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-amber-700">// 04</span>
          Seguridad Web, Criptografía y Certificados SSL
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-1" set:html={renderCards(securityWebTools)} />
      </section>

      <!-- SECCIÓN 5: DNS Inverso y Registros WHOIS -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-display font-bold text-neutral-900 uppercase tracking-wide flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-amber-700">// 05</span>
          DNS Inverso y Registros WHOIS
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-1" set:html={renderCards(whoisTools)} />
      </section>

      <!-- BLOQUE DE TEXTO TÉCNICO Y SEMÁNTICO INFERIOR (SEO ON-PAGE) -->
      <section class="bg-white/80 rounded-2xl p-6 sm:p-8 border border-zinc-300 shadow-xs space-y-4 font-sans text-zinc-700">
        <h3 class="text-base sm:text-lg font-display font-bold text-neutral-900 uppercase tracking-wide">
          Kit de Utilidades Técnicas para Ingeniería de Sistemas y Hardening de Servidores
        </h3>
        <p class="text-xs sm:text-sm leading-relaxed">
          El ecosistema de herramientas de <strong>Veyxara Tools</strong> ha sido diseñado específicamente para cubrir las necesidades operativas de los administradores de sistemas, ingenieros de redes y especialistas en ciberseguridad. Cada módulo funciona como una utilidad autónoma que facilita tareas complejas de diagnóstico, dimensionamiento y validación de normativas técnicas a nivel empresarial.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 text-xs sm:text-sm">
          <div class="space-y-1.5">
            <h4 class="font-bold text-neutral-900 uppercase tracking-wider font-mono text-xs">Optimización de Redes y Conectividad</h4>
            <p class="text-xs text-zinc-600">Calculadoras precisas de direccionamiento IP bajo esquemas CIDR y VLSM (tanto en IPv4 como en prefijos IPv6), auditorías de puertos TCP mediante pruebas de handshake directo y análisis detallado de trazas de red y redirecciones HTTP.</p>
          </div>
          <div class="space-y-1.5">
            <h4 class="font-bold text-neutral-900 uppercase tracking-wider font-mono text-xs">Seguridad de Correo y Autenticación DNS</h4>
            <p class="text-xs text-zinc-600">Validadores avanzados para normativas de correo electrónico corporativo (SPF, DKIM, DMARC y registros MX), diseñados para mitigar el spoofing, proteger dominios contra ataques de phishing y optimizar la entregabilidad SMTP.</p>
          </div>
        </div>
      </section>

      <!-- Pie de página con FAQ -->
      <div class="pt-4 text-center border-t border-zinc-300">
        <p class="text-xs sm:text-sm text-zinc-700 font-medium">
          ¿Tienes dudas sobre el funcionamiento o los parámetros? 
          <a href="/#faq" class="font-bold text-amber-800 hover:text-amber-900 hover:underline inline-flex items-center gap-1 ml-1 relative z-20 focus:outline-none">
            Consulta las Preguntas Frecuentes <span>↓</span>
          </a>
        </p>
      </div>

    </div>
  </main>
</Layout>